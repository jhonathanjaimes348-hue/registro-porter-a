<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Este proyecto no usa ningún paquete NuGet externo (solo las
    referencias de framework de Windows Forms, instaladas localmente con
    el SDK de .NET). Se desactivan las fuentes remotas para que
    "dotnet build" no intente salir a internet durante el restore.
  -->
  <packageSources>
    <clear />
  </packageSources>
</configuration>
